<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 o menos. Con allowBackup="false" en el manifest no hay backup en la nube;
   igual se excluye el código del federado (shared_prefs/federado.xml) por si algún día
   se vuelve a activar: es una credencial, y con él cualquiera manda ajustes a nombre de
   la persona.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="federado.xml" />
</full-backup-content>
