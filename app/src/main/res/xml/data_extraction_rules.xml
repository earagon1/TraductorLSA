<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+. allowBackup="false" apaga el backup en la nube, pero no la transferencia
   directa entre dispositivos al cambiar de teléfono: esa se deja (es la misma persona y
   sus propias tomas), salvo el código del federado (shared_prefs/federado.xml), que es
   una credencial. La regla de cloud-backup queda por si algún día se vuelve a activar.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="federado.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="federado.xml" />
    </device-transfer>
</data-extraction-rules>
