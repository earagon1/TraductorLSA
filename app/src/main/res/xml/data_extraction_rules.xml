<?xml version="1.0" encoding="utf-8"?><!--
   Backup y transferencia en Android 12+ (en 11 o menos manda backup_rules.xml).
   El código de participación del federado (shared_prefs/federado.xml) no sale del
   teléfono: es una credencial, y con él cualquiera puede mandar ajustes a nombre de la
   persona. Queda pendiente decidir qué más excluir (auditoría, TL-C2).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="federado.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="federado.xml" />
    </device-transfer>
</data-extraction-rules>
